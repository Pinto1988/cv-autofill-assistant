:root {
  color-scheme: light;
  --bg: #f4efe6;
  --card: rgba(255, 252, 247, 0.94);
  --ink: #1f2933;
  --muted: #5f6c7b;
  --line: rgba(31, 41, 51, 0.12);
  --accent: #a43d2d;
  --accent-dark: #7f2f22;
  --accent-soft: rgba(164, 61, 45, 0.12);
  --shadow: 0 20px 45px rgba(64, 39, 26, 0.14);
  font-family: "Segoe UI", "Helvetica Neue", sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 420px;
  background:
    radial-gradient(circle at top left, rgba(164, 61, 45, 0.16), transparent 36%),
    linear-gradient(180deg, #fbf7f0 0%, var(--bg) 100%);
  color: var(--ink);
}

.popup {
  padding: 18px;
}

.hero {
  margin-bottom: 14px;
}

.eyebrow {
  margin: 0 0 4px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--accent);
}

h1 {
  margin: 0;
  font-size: 24px;
  line-height: 1.1;
}

.subtitle {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.45;
}

.card {
  margin-top: 14px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--card);
  box-shadow: var(--shadow);
  backdrop-filter: blur(10px);
}

.file-picker {
  display: grid;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
}

.file-picker input {
  width: 100%;
}

.actions {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

button {
  border: 0;
  border-radius: 999px;
  padding: 10px 14px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 120ms ease, opacity 120ms ease, background 120ms ease;
}

button:hover {
  transform: translateY(-1px);
}

button:active {
  transform: translateY(0);
}

button.primary {
  background: var(--accent);
  color: #fff9f6;
}

button.primary:hover {
  background: var(--accent-dark);
}

button.secondary {
  background: var(--accent-soft);
  color: var(--accent-dark);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.section-title h2 {
  margin: 0;
  font-size: 15px;
}

.summary {
  margin-top: 12px;
  padding: 12px;
  border-radius: 14px;
  background: #fff;
  border: 1px solid var(--line);
  font-size: 12px;
  line-height: 1.5;
}

.summary.empty {
  color: var(--muted);
}

.summary-grid {
  display: grid;
  gap: 6px;
}

.summary-row strong {
  color: var(--accent-dark);
}

.editor-label {
  display: block;
  margin-top: 12px;
  margin-bottom: 6px;
  font-size: 12px;
  font-weight: 700;
}

textarea {
  width: 100%;
  min-height: 210px;
  resize: vertical;
  border-radius: 14px;
  border: 1px solid var(--line);
  padding: 12px;
  background: #fff;
  color: var(--ink);
  font-size: 12px;
  line-height: 1.45;
  font-family: Consolas, "SFMono-Regular", monospace;
}

.hint {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.status {
  margin: 12px 2px 4px;
  min-height: 18px;
  color: var(--accent-dark);
  font-size: 12px;
  font-weight: 700;
}
