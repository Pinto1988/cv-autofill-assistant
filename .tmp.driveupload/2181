{
  "manifest_version": 3,
  "name": "CV Autofill Assistant",
  "version": "0.1.0",
  "description": "Estrae i dati dal CV e prova a compilare automaticamente i form di candidatura.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "CV Autofill Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
